<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Diagnostic tool, not shipped with the module. Reads a crash dump of the game's
         .NET Framework 4.8 process from a .NET 8 host; ClrMD does that through the
         Framework's own DAC, so the host runtime does not matter. -->
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DumpProbe</AssemblyName>
    <RootNamespace>DumpProbe</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

</Project>
