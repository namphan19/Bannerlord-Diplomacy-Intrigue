<Prefab>
  <Window>
    <!-- The Realm tab's panel. Sits in the same slot as the five vanilla panels
         (MarginTop 188 / MarginBottom 75 come from the instance in
         KingdomManagement.xml's patched-in element) and is visible only while our
         DiRealm VM says Show - the same flag the vanilla categories flip.

         Layout follows the design proposal: a standing strip, a full-width wars strip
         (any war's "Negotiate peace" lives there), then three columns - our sphere,
         our claims, our agreements - the same split the mockup used. Cards use a
         plain coloured Widget (Sprite=BlankWhiteSquare_9 + Color) for backgrounds and
         left accent bars; Bannerlord already does this for the vanilla comparison
         bars, so no custom sprite is needed. -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@Show">
      <Children>

        <BrushListPanel WidthSizePolicy="Fixed" SuggestedWidth="1240" HeightSizePolicy="StretchToParent"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginTop="6" MarginBottom="9"
            Brush="Frame1Brush" StackLayout.LayoutMethod="VerticalTopToBottom">
          <Children>

            <!-- Standing strip -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="76"
                MarginTop="14" MarginLeft="24" MarginRight="24">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#24201888" />

                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginLeft="16" MarginRight="16" MarginTop="8" MarginBottom="8">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                          <Children>
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" Brush="DiRealm.Header" Brush.FontColor="@StandingColor"
                                IsEnabled="false" Text="@StandingTitle" />
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" MarginLeft="18" VerticalAlignment="Center"
                                Brush="DiRealm.Body" IsEnabled="false" Text="@StandingDetail" />
                          </Children>
                        </ListPanel>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4">
                          <Children>
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" Brush="DiRealm.Label" IsEnabled="false"
                                Text="@SphereStrengthText" />
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" MarginLeft="20" Brush="DiRealm.Label"
                                IsEnabled="false" Text="@DominanceText" />
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" MarginLeft="20" Brush="DiRealm.Label"
                                IsEnabled="false" Text="@AmbitionText" />
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" MarginLeft="20" Brush="DiRealm.Label"
                                Brush.FontColor="@GreedColor" IsEnabled="false" Text="@GreedText" />
                          </Children>
                        </ListPanel>
                        <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="CoverChildren" MarginTop="3" IsVisible="@HasPatronLine"
                            Brush="DiRealm.Small" IsEnabled="false" Text="@PatronLine" />
                      </Children>
                    </ListPanel>

                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="170"
                        SuggestedHeight="38" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Children>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent" Brush="ButtonBrush2"
                            UpdateChildrenStates="true" Command.Click="ExecuteWriteReport">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush="Kingdom.GeneralButtons.Text" Text="Write a report" />
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </Widget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- Scrollable body: wars strip, then the three columns -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                MarginLeft="18" MarginRight="14" MarginTop="8" MarginBottom="12">
              <Children>
                <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\RealmList"
                    VerticalScrollbar="..\RealmScrollbar\Scrollbar">
                  <Children>
                    <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                      <Children>
                        <ListPanel Id="RealmList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>

                            <!-- Our wars -->
                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                HeightSizePolicy="CoverChildren" MarginTop="4" MarginBottom="4" IsVisible="@HasWars"
                                Brush="DiRealm.Title" IsEnabled="false" Text="Our wars" />
                            <ListPanel DataSource="{Wars}" WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="CoverChildren"
                                StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    SuggestedHeight="62" MarginBottom="6">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Sprite="BlankWhiteSquare_9" Color="#201A1388" />
                                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="4" HeightSizePolicy="StretchToParent"
                                        Sprite="BlankWhiteSquare_9" Color="@AccentColor" />

                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        MarginLeft="16" MarginRight="14" MarginTop="7" MarginBottom="7">
                                      <Children>
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                            StackLayout.LayoutMethod="VerticalTopToBottom">
                                          <Children>
                                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                HeightSizePolicy="CoverChildren" Brush="DiRealm.Value"
                                                Brush.FontSize="19" Text="@Name" />
                                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren" MarginTop="2" Brush="DiRealm.Small"
                                                Text="@Detail" />
                                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren" MarginTop="2" Brush="DiRealm.Small"
                                                Text="@ConditionText" />
                                          </Children>
                                        </ListPanel>

                                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="76"
                                            HeightSizePolicy="StretchToParent" VerticalAlignment="Center">
                                          <Children>
                                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                Brush="DiRealm.Score" Brush.FontColor="@ScoreColor" Text="@ScoreText" />
                                          </Children>
                                        </Widget>

                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="132"
                                            SuggestedHeight="34" VerticalAlignment="Center" MarginLeft="10">
                                          <Children>
                                            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="StretchToParent" Brush="ButtonBrush2"
                                                UpdateChildrenStates="true" Command.Click="ExecuteNegotiate">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                    Brush="Kingdom.GeneralButtons.Text" Text="Peace table" />
                                              </Children>
                                            </ButtonWidget>
                                          </Children>
                                        </Widget>
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </Widget>
                              </ItemTemplate>
                            </ListPanel>

                            <!-- Three columns: our sphere / our claims / our agreements -->
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10">
                              <Children>

                                <!-- Column 1: our sphere -->
                                <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="430" HeightSizePolicy="CoverChildren"
                                    StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren" MarginBottom="4" IsVisible="@HasVassals"
                                        Brush="DiRealm.Title" IsEnabled="false" Text="Our sphere" />
                                    <ListPanel DataSource="{Vassals}" WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="86" MarginBottom="6">
                                          <Children>
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="#201A1388" />
                                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="4" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="@AccentColor" />

                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                MarginLeft="14" MarginRight="12" MarginTop="8" MarginBottom="8"
                                                StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Value"
                                                        Brush.FontSize="19" Text="@Name" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Label"
                                                        Text="@TributeText" />
                                                  </Children>
                                                </ListPanel>

                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    MarginTop="6">
                                                  <Children>
                                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                                                      <Children>
                                                        <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                            HeightSizePolicy="CoverChildren" Brush="DiRealm.Small"
                                                            Text="@HoldText" />
                                                        <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                            HeightSizePolicy="CoverChildren" MarginLeft="8" Brush="DiRealm.Small"
                                                            Brush.FontColor="@DriftColor" Text="@DriftText" />
                                                      </Children>
                                                    </ListPanel>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Small" Text="@ThresholdText" />
                                                  </Children>
                                                </ListPanel>

                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                    SuggestedWidth="160" SuggestedHeight="14" MarginTop="4">
                                                  <Children>
                                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                        Sprite="BlankWhiteSquare_9" Color="#14100BFF" />
                                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                                        SuggestedWidth="@ThresholdPixelWidth" Sprite="BlankWhiteSquare_9"
                                                        Color="#3A201CFF" />
                                                    <FillBarHorizontalWidget WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9"
                                                        Color="#00000000" FillWidget="HoldFill" InitialAmount="@HoldValue"
                                                        IsDirectionRightward="true" MaxAmount="100">
                                                      <Children>
                                                        <Widget Id="HoldFill" WidthSizePolicy="Fixed"
                                                            HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9"
                                                            Color="#D9A441FF" />
                                                      </Children>
                                                    </FillBarHorizontalWidget>
                                                  </Children>
                                                </Widget>

                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    MarginTop="5">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" IsVisible="@HasMarks"
                                                        Brush="DiRealm.Small" Brush.FontColor="#E08070FF" Text="@MarksText" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Small" Text="@TermText" />
                                                  </Children>
                                                </ListPanel>
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>
                                      </ItemTemplate>
                                    </ListPanel>

                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren" MarginTop="10" MarginBottom="4"
                                        IsVisible="@HasSpheres" Brush="DiRealm.Title" IsEnabled="false"
                                        Text="Spheres on the map" />
                                    <ListPanel DataSource="{Spheres}" WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="40" MarginBottom="5">
                                          <Children>
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="#1D171188" />
                                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="3" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="@AccentColor" />
                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                MarginLeft="12" MarginRight="10">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    VerticalAlignment="Center" StackLayout.LayoutMethod="VerticalTopToBottom">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Value" Text="@HeadText" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Small" Text="@VassalsText" />
                                                  </Children>
                                                </ListPanel>
                                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" SuggestedWidth="110"
                                                    HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Brush="DiRealm.Value" Text="@StrengthText" />
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>

                                <!-- Divider -->
                                <Widget WidthSizePolicy="Fixed" SuggestedWidth="1" HeightSizePolicy="StretchToParent"
                                    MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare_9" Color="#3A2F24FF" />

                                <!-- Column 2: our claims -->
                                <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="330" HeightSizePolicy="CoverChildren"
                                    StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren" MarginBottom="4" IsVisible="@HasClaims"
                                        Brush="DiRealm.Title" IsEnabled="false" Text="Our claims" />
                                    <ListPanel DataSource="{Claims}" WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            MarginBottom="6">
                                          <Children>
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="#201A1388" />
                                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="4" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="@AccentColor" />

                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                MarginLeft="14" MarginRight="12" MarginTop="8" MarginBottom="8"
                                                StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <Children>
                                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="CoverChildren" Brush="DiRealm.Value"
                                                    Brush.FontSize="18" Text="@KingdomText" />

                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                                    MarginTop="4">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Body" Text="@TypeText" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                                        HeightSizePolicy="CoverChildren" IsVisible="@HasLegitimacy"
                                                        Brush="DiRealm.Value" Brush.FontColor="@LegitimacyColor"
                                                        Text="@LegitimacyText" />
                                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                        SuggestedWidth="52" SuggestedHeight="19" MarginLeft="6"
                                                        VerticalAlignment="Center" IsVisible="@IsLand">
                                                      <Children>
                                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            Sprite="BlankWhiteSquare_9" Color="#9AC26AFF" />
                                                        <TextWidget WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="StretchToParent" Brush="DiRealm.Badge"
                                                            Text="LAND" />
                                                      </Children>
                                                    </Widget>
                                                  </Children>
                                                </ListPanel>

                                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                                    SuggestedWidth="270" SuggestedHeight="8" MarginTop="6"
                                                    IsVisible="@IsFabricating">
                                                  <Children>
                                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                        Sprite="BlankWhiteSquare_9" Color="#14100BFF" />
                                                    <FillBarHorizontalWidget WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9"
                                                        Color="#00000000" FillWidget="ClaimFill" InitialAmount="@Progress"
                                                        IsDirectionRightward="true" MaxAmount="100">
                                                      <Children>
                                                        <Widget Id="ClaimFill" WidthSizePolicy="Fixed"
                                                            HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9"
                                                            Color="#8A7448FF" />
                                                      </Children>
                                                    </FillBarHorizontalWidget>
                                                  </Children>
                                                </Widget>

                                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="CoverChildren" MarginTop="4" IsVisible="@HasFooter"
                                                    Brush="DiRealm.Small" Text="@FooterText" />
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>

                                <!-- Divider -->
                                <Widget WidthSizePolicy="Fixed" SuggestedWidth="1" HeightSizePolicy="StretchToParent"
                                    MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare_9" Color="#3A2F24FF" />

                                <!-- Column 3: our agreements -->
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                                        HeightSizePolicy="CoverChildren" MarginBottom="4" IsVisible="@HasAgreements"
                                        Brush="DiRealm.Title" IsEnabled="false" Text="Our agreements" />
                                    <ListPanel DataSource="{Agreements}" WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                      <ItemTemplate>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="64" MarginBottom="6">
                                          <Children>
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="#201A1388" />
                                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="4" HeightSizePolicy="StretchToParent"
                                                Sprite="BlankWhiteSquare_9" Color="@AccentColor" />

                                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                MarginLeft="14" MarginRight="12" MarginTop="7" MarginBottom="7"
                                                StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <Children>
                                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                                                  <Children>
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren" Brush="DiRealm.Value" Text="@TypeText" />
                                                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed"
                                                        SuggestedWidth="210" HeightSizePolicy="CoverChildren"
                                                        HorizontalAlignment="Right" Brush="DiRealm.Small"
                                                        Brush.FontColor="@TermColor" Text="@TermText" />
                                                  </Children>
                                                </ListPanel>
                                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="CoverChildren" MarginTop="3" Brush="DiRealm.Body"
                                                    Text="@DetailText" />
                                              </Children>
                                            </ListPanel>
                                          </Children>
                                        </Widget>
                                      </ItemTemplate>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>

                              </Children>
                            </ListPanel>

                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <Standard.VerticalScrollbar Id="RealmScrollbar" HeightSizePolicy="StretchToParent"
                    HorizontalAlignment="Right" MarginLeft="2" MarginRight="2" />
              </Children>
            </ListPanel>

          </Children>
        </BrushListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
