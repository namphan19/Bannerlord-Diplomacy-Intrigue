<Prefab>
  <Window>
    <!-- Sibling after the game's own proposal list, inside the same bottom strip.
         DataSource narrows to the selected item; IsAcceptableItemSelected lives on the
         panel VM and must not be asked for here (wrong data context, silently false).
         A grid, not a horizontal stack: up to eight buttons can be up at once, and a
         single row of 240px columns would run off the pane. Five columns (1200px of a
         pane about 1260 wide) keep the common case on one row - at peace a ruler has five
         actions (propose, declare war, demand tribute, kneel, fabricate), and four
         columns pushed the fifth under the first. Six or more still wrap.
         The button label carries the mockup's kind colour (green is good for us, red is
         bad for us, gold is a threshold): a label colour binds, a button background
         does not. -->
    <ListPanel DataSource="{CurrentSelectedDiplomacyItem}"
        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
        HorizontalAlignment="Center" MarginTop="8"
        IsVisible="@DiHasHeadline">
      <Children>
        <NavigatableGridWidget DataSource="{DiActions}" WidthSizePolicy="Fixed" SuggestedWidth="1200"
            HeightSizePolicy="CoverChildren" HorizontalAlignment="Center"
            DefaultCellWidth="240" DefaultCellHeight="110" ColumnCount="5"
            LayoutImp.VerticalLayoutMethod="TopToBottom">
          <ItemTemplate>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="5" MarginRight="5"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
              <Children>
                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="220"
                    HeightSizePolicy="CoverChildren" Brush="Kingdom.ParagraphSmall.Text"
                    MarginBottom="8" Text="@Explanation" IsEnabled="@IsEnabled"
                    DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="227"
                    SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    MarginBottom="2">
                  <Children>
                    <HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint"
                        Command.HoverEnd="ExecuteEndHint" IsEnabled="false" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" Brush="ButtonBrush2"
                        UpdateChildrenStates="true" Command.Click="ExecuteAction"
                        IsEnabled="@IsEnabled">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Brush="Kingdom.GeneralButtons.Text" Brush.FontColor="@LabelColor"
                            Text="@Name" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
                <!-- Fixed height even when there is no price, as in the mockup: the
                     cells align to the bottom, so a cost row that collapsed to nothing
                     left priced buttons standing higher than unpriced ones. -->
                <ListPanel DoNotAcceptEvents="true" DoNotPassEventsToChildren="true"
                    WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="27"
                    HorizontalAlignment="Center">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Brush="Kingdom.GeneralButtons.Text" IntText="@InfluenceCost"
                        IsEnabled="@IsEnabled" IsVisible="@HasInfluenceCost" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="17"
                        SuggestedHeight="27" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Sprite="SPKingdom\influence_icon_small" IsVisible="@HasInfluenceCost" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Brush="Kingdom.GeneralButtons.Text" Text="@CostText"
                        IsEnabled="@IsEnabled" IsVisible="@HasCostText" />
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </ItemTemplate>
        </NavigatableGridWidget>
      </Children>
    </ListPanel>
  </Window>
</Prefab>
