<Prefab>
  <Window>
    <!-- "What their court would sign": one number, three rungs. The bar is their
         court's own valuation of a pact with us; the gold mark on it is the bar each
         rung has to clear. Green when they would sign, red when they refuse, grey when
         the pact is structurally impossible - the mockup's palette. Verdict is a badge
         plate in the same hue: a brush border colour cannot be bound, so the badge is a
         soft fill with the verdict's own text colour over it. -->
    <ListPanel DataSource="{CurrentSelectedDiplomacyItem}"
        WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
        HorizontalAlignment="Center" MarginTop="8" MarginBottom="6"
        IsVisible="@DiShowPacts" StackLayout.LayoutMethod="VerticalTopToBottom">
      <Children>

        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren">
          <Children>
            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                HeightSizePolicy="CoverChildren"
                Brush="ArmyManagement.Army.Tuple.Name" Brush.FontSize="20"
                IsEnabled="false" Text="What their court would sign" />
            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren"
                HeightSizePolicy="CoverChildren" MarginLeft="16"
                Brush="ArmyManagement.Army.Tuple.Name" Brush.FontSize="16"
                IsEnabled="false" Text="@DiPactValueText" />
          </Children>
        </ListPanel>

        <NavigatableListPanel DataSource="{DiPactRungs}" WidthSizePolicy="CoverChildren"
            HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="6"
            StackLayout.LayoutMethod="VerticalTopToBottom" MinIndex="0" StepSize="1000">
          <ItemTemplate>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                MarginTop="4">
              <Children>

                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" SuggestedWidth="176"
                    HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                    Brush="Kingdom.ParagraphSmall.Text" Brush.FontColor="@NameColor" Text="@Name" />

                <!-- The bar, with the gold mark the bar has to clear -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="170" SuggestedHeight="22" VerticalAlignment="Center">
                  <Children>
                    <FillBarHorizontalWidget DoNotAcceptEvents="true"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="#00000040"
                        FillWidget="FillWidget" InitialAmount="@BarValue"
                        IsDirectionRightward="true" MaxAmount="100">
                      <Children>
                        <Widget Id="FillWidget" WidthSizePolicy="Fixed"
                            HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9" AlphaFactor="0.7" Color="@BarColor" />
                      </Children>
                    </FillBarHorizontalWidget>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        DoNotAcceptEvents="true" DoNotPassEventsToChildren="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="@NeedPixelOffset" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="2" Sprite="BlankWhiteSquare_9" Color="#E6C87FFF" />
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" SuggestedWidth="132"
                    HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="8"
                    Brush="ArmyManagement.Army.Tuple.Name" Brush.FontSize="16" Text="@DetailText" />

                <!-- Verdict badge: soft plate in the verdict's hue -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="108"
                    SuggestedHeight="26" VerticalAlignment="Center">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="BlankWhiteSquare_9" Color="@VerdictBackColor" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Brush="ArmyManagement.Army.Tuple.Name" Brush.FontSize="16"
                        Brush.TextHorizontalAlignment="Center"
                        Brush.FontColor="@VerdictColor" Text="@VerdictText" />
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150"
                    SuggestedHeight="34" VerticalAlignment="Center" MarginLeft="8">
                  <Children>
                    <HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint"
                        Command.HoverEnd="ExecuteEndHint" IsEnabled="false" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="StretchToParent" Brush="ButtonBrush2"
                        UpdateChildrenStates="true" Command.Click="ExecutePropose"
                        IsEnabled="@CanPropose">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Brush="Kingdom.GeneralButtons.Text" Text="Propose" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>

                <ListPanel DoNotAcceptEvents="true" DoNotPassEventsToChildren="true"
                    WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="6"
                    IsVisible="@HasInfluenceCost">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        VerticalAlignment="Center" Brush="Kingdom.GeneralButtons.Text"
                        IntText="@InfluenceCost" IsEnabled="@CanPropose" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="17"
                        SuggestedHeight="27" VerticalAlignment="Center"
                        Sprite="SPKingdom\influence_icon_small" />
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>
          </ItemTemplate>
        </NavigatableListPanel>

        <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" SuggestedWidth="840"
            HeightSizePolicy="CoverChildren" MarginTop="8"
            Brush="Kingdom.ParagraphSmall.Text" IsEnabled="false"
            Text="One valuation, three bars: the gold mark is the bar each treaty has to clear. This is the number their court uses - there is no separate figure for the player." />

      </Children>
    </ListPanel>
  </Window>
</Prefab>
