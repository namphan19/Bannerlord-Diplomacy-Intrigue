<!-- Brushes for the Kingdom screen's Realm tab (RealmVM.cs / DiRealmPanel.xml).
     Left-aligned variants of the vanilla styles used elsewhere in the panel, plus a
     couple of sizes the vanilla set does not have (a small uppercase-ish label, and a
     tiny bold badge). Colour where the row needs to vary (score, drift, accents) comes
     from Brush.FontColor bound to a Color property instead of a second brush -
     Bannerlord already does this for faction-coloured text (PartyNameplateItem.xml). -->
<Brushes>

  <Brush Name="DiRealm.Header" Font="Galahad" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#E6C87FFF" TextOutlineAmount="0.1" TextGlowRadius="0" TextBlur="0.2" TextShadowOffset="0" FontSize="26" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Title" Font="Galahad" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#E6C87FFF" TextOutlineAmount="0.1" TextGlowRadius="0" TextBlur="0.2" TextShadowOffset="0" FontSize="20" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Value" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#E0CFA8FF" TextOutlineAmount="0" TextGlowRadius="0.0" TextBlur="0" TextShadowOffset="0" FontSize="20" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Body" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#DDD0B8FF" TextOutlineAmount="0" TextGlowRadius="0.0" TextBlur="0" TextShadowOffset="0" FontSize="17" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Label" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#A89878FF" TextOutlineAmount="0" TextGlowRadius="0.0" TextBlur="0" TextShadowOffset="0" FontSize="15" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Small" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#7E6F56FF" TextOutlineAmount="0" TextGlowRadius="0.0" TextBlur="0" TextShadowOffset="0" FontSize="14" />
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Badge" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#15100CFF" TextOutlineAmount="0" TextGlowRadius="0.0" TextBlur="0" TextShadowOffset="0" FontSize="13" />
    </Styles>
  </Brush>

  <!-- A peace-table term row (DiPeaceTable.xml): clear at rest, the mockup's #2c2619
       once ticked (bound through IsSelected), a lift on hover. Drawn from
       BlankWhiteSquare_9 only. The first pass borrowed Kingdom.Item.Tuple, whose
       SPKingdom sprite is loaded with the Kingdom screen and not otherwise - over the
       map the rows lost their background and every hover and ticked state with it. -->
  <Brush Name="DiPeace.Row">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#FFFFFFFF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" Color="#2C261900" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" Color="#3A2F24AA" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" Color="#3A2F1FFF" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" Color="#4A3C2AFF" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" Color="#2C261900" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="DiRealm.Score" Font="Galahad" TextHorizontalAlignment="Right">
    <Styles>
      <Style Name="Default" FontColor="#E0CFA8FF" TextOutlineAmount="0.1" TextGlowRadius="0" TextBlur="0.2" TextShadowOffset="0" FontSize="22" />
    </Styles>
  </Brush>

</Brushes>
