<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Name value="Diplomacy &amp; Intrigue"/>
  <Id value="DiplomacyIntrigue"/>
  <Version value="v0.3.0"/>
  <DefaultModule value="false"/>
  <ModuleCategory value="Singleplayer"/>
  <ModuleType value="Community"/>

  <DependedModules>
    <DependedModule Id="Native"                     DependentVersion="v1.4.8"  Optional="false"/>
    <DependedModule Id="SandBoxCore"                DependentVersion="v1.4.8"  Optional="false"/>
    <!-- NOTE: the SandBox folder declares its Id as "Sandbox" (lowercase b). -->
    <DependedModule Id="Sandbox"                    DependentVersion="v1.4.8"  Optional="false"/>
    <DependedModule Id="StoryMode"                  DependentVersion="v1.4.8"  Optional="false"/>
    <DependedModule Id="Bannerlord.Harmony"         DependentVersion="v2.4.2"  Optional="false"/>
    <DependedModule Id="Bannerlord.ButterLib"       DependentVersion="v2.10.4" Optional="false"/>
    <DependedModule Id="Bannerlord.UIExtenderEx"    DependentVersion="v2.13.2" Optional="false"/>
    <DependedModule Id="Bannerlord.MBOptionScreen"  DependentVersion="v5.11.4" Optional="false"/>
  </DependedModules>

  <!-- Read only by BUTR's launcher and BLSE, which then refuse to start the pair together; the
       official launcher ignores this block, so SubModule.WarnAboutIncompatibleModules covers it at
       runtime too. Bannerlord.Diplomacy is the id in DiplomacyTeam/Bannerlord.Diplomacy's csproj
       (checked 2026-10-03). Only the incompatibility is declared here: the load order of the
       modules above stays with DependedModules, which BUTR's parser keeps as a separate list. -->
  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Bannerlord.Diplomacy" incompatible="true"/>
  </DependedModuleMetadatas>

  <SubModules>
    <SubModule>
      <Name value="DiplomacyIntrigue"/>
      <DLLName value="DiplomacyIntrigue.dll"/>
      <SubModuleClassType value="DiplomacyIntrigue.SubModule"/>
      <Tags>
        <Tag key="DedicatedServerType" value="none"/>
        <Tag key="IsNoRenderModeElement" value="false"/>
      </Tags>
    </SubModule>
  </SubModules>

  <Xmls/>
</Module>
